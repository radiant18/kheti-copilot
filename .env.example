# Free key from https://data.gov.in — sign in, then My Account -> API key.
# Without it the market screen falls back to bundled sample prices.
DATA_GOV_API_KEY=

# Only needed for the Capacitor builds: the origin the mobile app calls.
# Leave blank for web (same-origin /api/*).
NEXT_PUBLIC_API_BASE=

# Enables the "Ask your farm" voice assistant. Without it the rest of the app
# works normally and the assistant says it is switched off.
ANTHROPIC_API_KEY=

# Signs the proof-of-number token handed out after a sign-in code is answered.
# Any long random string — `openssl rand -hex 32`. In production a missing key
# is a hard stop, because an unsigned token is a forgeable one; in development
# it falls back to a known constant so the flow runs with no setup.
OTP_SECRET=

# Sign-in codes go by SMS. An Indian transactional SMS needs a DLT
# registration — an approved six-letter sender header and an approved template
# with the code as a variable — which is paperwork against a business entity,
# not something the app can arrange. Pick one provider; leaving SMS_PROVIDER
# blank uses whichever set of keys is filled in.
SMS_PROVIDER=

#   MSG91 — the usual Indian choice. Template id is the DLT flow template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
#   Name of the variable in that template. Default OTP.
MSG91_VAR_NAME=OTP

#   Twilio — works anywhere and is the easier one to test with. To an Indian
#   number it still needs the DLT registration above, and the message body in
#   lib/sms.ts must match the approved wording exactly.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# The 5am WhatsApp plan. Without these the daily job runs and reports what it
# would have sent, but sends nothing.
#   1. Meta Business account with a WhatsApp number gives you these two:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
#   2. A business cannot open a conversation with free-form text. Register a
#      template with a single {{1}} body variable and put its name here.
WHATSAPP_TEMPLATE_NAME=daily_farm_plan
WHATSAPP_TEMPLATE_LANG=en
#      WhatsApp is also the fallback for sign-in codes when no SMS provider is
#      set, which needs a second template, again with one {{1}} body variable.
#      With neither SMS nor WhatsApp, codes are shown on screen in development
#      and refused outright in production.
WHATSAPP_OTP_TEMPLATE_NAME=kheti_login_code
#   3. Shared secret so only Vercel Cron can trigger the send.
CRON_SECRET=
